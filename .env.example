# Keep real values in .env.local. Never expose these with NEXT_PUBLIC_ prefixes.
OPENAI_API_KEY=

# Shared read-only Google Ads OAuth/developer credentials. Client account IDs are below.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v22
# TODAY, YESTERDAY, LAST_7_DAYS, LAST_14_DAYS, LAST_30_DAYS, THIS_MONTH, or LAST_MONTH
GOOGLE_ADS_DATE_RANGE=LAST_30_DAYS

# Shared GA4 service-account credentials. Property IDs are client-specific below.
GA4_CLIENT_EMAIL=
# Paste the JSON key's private_key value on one line with literal \n line breaks.
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GA4 accepts today, yesterday, NdaysAgo, or YYYY-MM-DD.
GA4_START_DATE=30daysAgo
GA4_END_DATE=yesterday

# Demo workspace. It uses the bundled sample dataset by default.
DEMO_CLIENT_NAME=Crush Demo Workspace
DEMO_DATA_SOURCE=sample
DEMO_GOOGLE_ADS_CUSTOMER_ID=
DEMO_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
DEMO_GA4_PROPERTY_ID=

# Client A workspace. Missing IDs degrade safely to sample/unconfigured states.
CLIENT_A_NAME=Client A Workspace
CLIENT_A_DATA_SOURCE=live
CLIENT_A_GOOGLE_ADS_CUSTOMER_ID=
CLIENT_A_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
CLIENT_A_GA4_PROPERTY_ID=

# Client B workspace.
CLIENT_B_NAME=Client B Workspace
CLIENT_B_DATA_SOURCE=live
CLIENT_B_GOOGLE_ADS_CUSTOMER_ID=
CLIENT_B_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
CLIENT_B_GA4_PROPERTY_ID=

# Backward compatibility: legacy GOOGLE_ADS_DATA_SOURCE, GOOGLE_ADS_CUSTOMER_ID,
# GOOGLE_ADS_LOGIN_CUSTOMER_ID, and GA4_PROPERTY_ID values are treated as demo
# workspace settings when their DEMO_* equivalents are absent.

# Daily Analysis uses completed calendar days in this IANA timezone (UTC by default).
DAILY_ANALYSIS_TIME_ZONE=UTC
# Optional storage root. Files are written under clients/{clientId}/daily-analysis.
DAILY_ANALYSIS_STORAGE_DIR=
# Vercel uses a connected private Blob store for durable analysis and report history.
BLOB_READ_WRITE_TOKEN=
# Protects both daily-analysis and weekly-report cron routes. Use a long random server-only value.
CRON_SECRET=

# Weekly reports inherit DAILY_ANALYSIS_TIME_ZONE unless this is set.
WEEKLY_REPORT_TIME_ZONE=
# Optional storage root. Files are written under clients/{clientId}/weekly-reports.
WEEKLY_REPORT_STORAGE_DIR=
