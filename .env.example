# Keep real values in .env.local. Never expose these with NEXT_PUBLIC_ prefixes.
GOOGLE_ADS_DATA_SOURCE=sample
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Required only when accessing a client through a Google Ads manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Override when upgrading to another supported Google Ads API version.
GOOGLE_ADS_API_VERSION=v22
# TODAY, YESTERDAY, LAST_7_DAYS, LAST_14_DAYS, LAST_30_DAYS, THIS_MONTH, or LAST_MONTH
GOOGLE_ADS_DATE_RANGE=LAST_30_DAYS

# Optional GA4 Data API context. All values are server-only; never add NEXT_PUBLIC_ prefixes.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Paste the JSON key's private_key value on one line with literal \n line breaks.
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GA4 accepts today, yesterday, NdaysAgo, or YYYY-MM-DD.
GA4_START_DATE=30daysAgo
GA4_END_DATE=yesterday
